FLASK_ENV=development
FLASK_DEBUG=1

# MySQL (pick ONE: DATABASE_URL OR the component variables below)
#
# Recommended:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/pulsedb

# Components (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pulsedb
DB_USER=root
DB_PASSWORD=your_password

JWT_SECRET_KEY=change-this-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Bcrypt settings
BCRYPT_LOG_ROUNDS=12

# Rate limiting (Flask-Limiter)
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URL=memory://
